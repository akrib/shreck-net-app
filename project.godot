; Nosferatu Intelligence — prototype de stockage (étape 2)

config_version=5

[application]

config/name="Nosferatu Intelligence (prototype)"
config/description="Poste de renseignement personnel — version PC"
config/version="0.18"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=3
window/stretch/mode="disabled"

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
